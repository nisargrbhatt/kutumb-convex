{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "kutumb",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"main": "@tanstack/react-start/server-entry",
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
		},
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_id": "ffedc984-cd62-447b-9792-86bc41610a82",
		},
	],
	"kv_namespaces": [
		{
			"binding": "KV",
			"id": "75a706cda3c44a00949860c48ee271ab",
		},
	],
	// Per-`clientId:userId:orgId` caps (src/server/mcp). Period must be 10 or 60.
	"ratelimits": [
		// Every /api/mcp request (endpoint.ts).
		{
			"name": "MCP_RATE_LIMITER",
			"namespace_id": "1001",
			"simple": { "limit": 60, "period": 60 },
		},
		// Write-tool calls only (tools/writeSupport.ts). Keep the limit equal to WRITE_BURST_LIMIT.
		{
			"name": "MCP_WRITE_RATE_LIMITER",
			"namespace_id": "1002",
			"simple": { "limit": 10, "period": 60 },
		},
	],
	"preview_urls": false,
	"workers_dev": true,
	"keep_vars": true,
	"routes": [
		{
			"pattern": "kutumb.nisargbhatt.org",
			"zone_name": "nisargbhatt.org",
			"custom_domain": true,
		},
	],
}
